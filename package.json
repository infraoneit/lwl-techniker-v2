{
  "name": "lwl-techniker-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/erzeuge-formulare.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pruefe-konfiguration.mjs --build && node scripts/pruefe-texte.mjs --build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/*.test.mjs\"",
    "formulare": "node scripts/erzeuge-formulare.mjs",
    "pruefen:konfiguration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pruefe-konfiguration.mjs",
    "pruefen:texte": "node scripts/pruefe-texte.mjs",
    "pruefen:bilder": "node scripts/pruefe-bilder.mjs",
    "pruefen": "npm run formulare && npm run pruefen:konfiguration && npm run pruefen:texte && npm run pruefen:bilder && npm run typecheck && npm run lint && npm test",
    "bilder:optimieren": "node scripts/optimiere-bilder.mjs"
  },
  "dependencies": {
    "@keystatic/core": "0.6.9",
    "@keystatic/next": "5.0.5",
    "@markdoc/markdoc": "0.4.0",
    "clsx": "2.1.1",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
